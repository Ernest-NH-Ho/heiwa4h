  ATOMS856=2712,2796 SWITCH856={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.39426} WEIGHT856=0.001160092807
  ATOMS857=2715,2793 SWITCH857={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.39872} WEIGHT857=0.001160092807
  ATOMS858=2715,2796 SWITCH858={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.39862} WEIGHT858=0.001160092807
  ATOMS859=2724,2820 SWITCH859={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.39953} WEIGHT859=0.001160092807
  ATOMS860=2728,2786 SWITCH860={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.30847} WEIGHT860=0.001160092807
  ATOMS861=2728,2793 SWITCH861={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.38013} WEIGHT861=0.001160092807
  ATOMS862=2728,2800 SWITCH862={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.33687} WEIGHT862=0.001160092807
  SUM
... q:


# ============================================================
# 2. Optional walls defining the region of interest
# ============================================================

lower: LOWER_WALLS ARG=q AT=0.5 KAPPA=3000.0 EXP=2
upper: UPPER_WALLS ARG=q AT=1.02 KAPPA=3000.0 EXP=2


# ============================================================
# 3. Well-tempered metadynamics
# ============================================================

MOLINFO STRUCTURE=md_relax_310K_310K_30ns_r0_pbc_center_compact_dump29999_Protein.pdb

meta: METAD ...
    ARG=q
    SIGMA=0.02
    HEIGHT=0.0
    PACE=99999999
    TEMP=310.0
    BIASFACTOR=10.0
    GRID_MIN=-0.02
    GRID_MAX=1.05
    GRID_BIN=250
    FILE=HILLS
... meta:


# Remove all biases
weights: REWEIGHT_BIAS ...
    ARG=meta.bias,lower.bias,upper.bias
    TEMP=310
... weights:

# Construct the unbiased q distribution
histo: HISTOGRAM ...
    ARG=q
    GRID_MIN=-0.02
    GRID_MAX=1.05
    GRID_BIN=100
    BANDWIDTH=0.02
    LOGWEIGHTS=weights
... histo:

# Convert probability into free energy
fes: CONVERT_TO_FES ...
    GRID=histo
    TEMP=310
... fes:

DUMPGRID GRID=histo FILE=histo_q.dat STRIDE=0
DUMPGRID GRID=fes FILE=fes_q.dat STRIDE=0

PRINT ARG=q,meta.bias,lower.bias,upper.bias,weights       FILE=COLVAR_REWEIGHT STRIDE=500
    