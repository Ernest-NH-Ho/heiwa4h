  ATOMS438=1547,1621 SWITCH438={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.38467} WEIGHT438=0.002252252252
  ATOMS439=1548,1618 SWITCH439={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.36984} WEIGHT439=0.002252252252
  ATOMS440=1548,1621 SWITCH440={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.34458} WEIGHT440=0.002252252252
  ATOMS441=1549,1618 SWITCH441={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.39122} WEIGHT441=0.002252252252
