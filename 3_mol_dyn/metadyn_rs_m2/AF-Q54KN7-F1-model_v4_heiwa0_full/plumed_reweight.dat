  ATOMS434=1498,1558 SWITCH434={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.36825} WEIGHT434=0.002252252252
  ATOMS435=1498,1560 SWITCH435={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.37347} WEIGHT435=0.002252252252
  ATOMS436=1539,1593 SWITCH436={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.35914} WEIGHT436=0.002252252252
