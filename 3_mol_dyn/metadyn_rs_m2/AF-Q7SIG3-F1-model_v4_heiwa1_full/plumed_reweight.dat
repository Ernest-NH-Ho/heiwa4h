  ATOMS1381=3367,3424 SWITCH1381={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.39308} WEIGHT1381=0.0007225433526
  ATOMS1382=3367,3426 SWITCH1382={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.37487} WEIGHT1382=0.0007225433526
  ATOMS1383=3367,3428 SWITCH1383={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.36963} WEIGHT1383=0.0007225433526
  ATOMS1384=3367,3432 SWITCH1384={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.33295} WEIGHT1384=0.0007225433526
  SUM
... q:


# ============================================================
# 2. Optional walls defining the region of interest
# ============================================================

lower: LOWER_WALLS ARG=q AT=0.5 KAPPA=3000.0 EXP=2
upper: UPPER_WALLS ARG=q AT=1.02 KAPPA=3000.0 EXP=2


# ============================================================
# 3. Well-tempered metadynamics
# ============================================================

MOLINFO STRUCTURE=md_relax_310K_310K_30ns_r0_pbc_center_compact_dump29999_Protein.pdb

meta: METAD ...
    ARG=q
    SIGMA=0.02
    HEIGHT=0.0
    PACE=99999999
    TEMP=310.0
    BIASFACTOR=10.0
    GRID_MIN=-0.02
    GRID_MAX=1.05
    GRID_BIN=250
    FILE=HILLS
... meta:


# Remove all biases
weights: REWEIGHT_BIAS ...
    ARG=meta.bias,lower.bias,upper.bias
    TEMP=310
... weights:

# Construct the unbiased q distribution
histo: HISTOGRAM ...
    ARG=q
    GRID_MIN=-0.02
    GRID_MAX=1.05
    GRID_BIN=100
    BANDWIDTH=0.02
    LOGWEIGHTS=weights
... histo:

# Convert probability into free energy
fes: CONVERT_TO_FES ...
    GRID=histo
    TEMP=310
... fes:

DUMPGRID GRID=histo FILE=histo_q.dat STRIDE=0
DUMPGRID GRID=fes FILE=fes_q.dat STRIDE=0

PRINT ARG=q,meta.bias,lower.bias,upper.bias,weights       FILE=COLVAR_REWEIGHT STRIDE=500
    