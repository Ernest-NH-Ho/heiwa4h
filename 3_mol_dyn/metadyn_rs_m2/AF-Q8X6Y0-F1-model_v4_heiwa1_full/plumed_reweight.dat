  ATOMS994=3218,3277 SWITCH994={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.34852} WEIGHT994=0.001001001001
  ATOMS995=3236,3281 SWITCH995={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.37754} WEIGHT995=0.001001001001
  ATOMS996=3236,3284 SWITCH996={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.32749} WEIGHT996=0.001001001001
  ATOMS997=3237,3281 SWITCH997={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.34608} WEIGHT997=0.001001001001
  ATOMS998=3237,3284 SWITCH998={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.28432} WEIGHT998=0.001001001001
  ATOMS999=3251,3295 SWITCH999={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.33519} WEIGHT999=0.001001001001
  SUM
... q:


# ============================================================
# 2. Optional walls defining the region of interest
# ============================================================

lower: LOWER_WALLS ARG=q AT=0.5 KAPPA=3000.0 EXP=2
upper: UPPER_WALLS ARG=q AT=1.02 KAPPA=3000.0 EXP=2


# ============================================================
# 3. Well-tempered metadynamics
# ============================================================

MOLINFO STRUCTURE=md_relax_310K_310K_30ns_r0_pbc_center_compact_dump29999_Protein.pdb

meta: METAD ...
    ARG=q
    SIGMA=0.02
    HEIGHT=0.0
    PACE=99999999
    TEMP=310.0
    BIASFACTOR=10.0
    GRID_MIN=-0.02
    GRID_MAX=1.05
    GRID_BIN=250
    FILE=HILLS
... meta:


# Remove all biases
weights: REWEIGHT_BIAS ...
    ARG=meta.bias,lower.bias,upper.bias
    TEMP=310
... weights:

# Construct the unbiased q distribution
histo: HISTOGRAM ...
    ARG=q
    GRID_MIN=-0.02
    GRID_MAX=1.05
    GRID_BIN=100
    BANDWIDTH=0.02
    LOGWEIGHTS=weights
... histo:

# Convert probability into free energy
fes: CONVERT_TO_FES ...
    GRID=histo
    TEMP=310
... fes:

DUMPGRID GRID=histo FILE=histo_q.dat STRIDE=0
DUMPGRID GRID=fes FILE=fes_q.dat STRIDE=0

PRINT ARG=q,meta.bias,lower.bias,upper.bias,weights       FILE=COLVAR_REWEIGHT STRIDE=500
    