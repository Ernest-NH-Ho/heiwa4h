  SUM
... q:


# ============================================================
# 2. Optional walls defining the region of interest
# ============================================================

lower: LOWER_WALLS ARG=q AT=0.5 KAPPA=3000.0 EXP=2
upper: UPPER_WALLS ARG=q AT=1.02 KAPPA=3000.0 EXP=2


# ============================================================
# 3. Well-tempered metadynamics
# ============================================================

meta: METAD ...
    ARG=q
    SIGMA=0.02
    HEIGHT=0.3
    PACE=500
    TEMP=310.0
    BIASFACTOR=10.0
    GRID_MIN=-0.02
    GRID_MAX=1.05
    GRID_BIN=250
    FILE=HILLS
... meta:

# ============================================================
# 4. Write output
# ============================================================

PRINT ...
    ARG=q,meta.bias,lower.bias,upper.bias
    STRIDE=500
    FILE=COLVAR
... PRINT
