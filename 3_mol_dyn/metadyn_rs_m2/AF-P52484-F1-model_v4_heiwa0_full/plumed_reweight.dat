  ATOMS990=3419,3489 SWITCH990={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.37569} WEIGHT990=0.001005025126
  ATOMS991=3437,3495 SWITCH991={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.39607} WEIGHT991=0.001005025126
