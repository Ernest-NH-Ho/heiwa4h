  ATOMS718=2657,2721 SWITCH718={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.37310} WEIGHT718=0.001379310345
  ATOMS719=2679,2729 SWITCH719={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.32822} WEIGHT719=0.001379310345
  ATOMS720=2679,2733 SWITCH720={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.34499} WEIGHT720=0.001379310345
  ATOMS721=2698,2748 SWITCH721={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.31893} WEIGHT721=0.001379310345
  ATOMS722=2698,2750 SWITCH722={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.38724} WEIGHT722=0.001379310345
  ATOMS723=2698,2752 SWITCH723={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.31914} WEIGHT723=0.001379310345
  ATOMS724=2713,2765 SWITCH724={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.36426} WEIGHT724=0.001379310345
  ATOMS725=2713,2768 SWITCH725={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.39793} WEIGHT725=0.001379310345
  SUM
... q:


# ============================================================
# 2. Optional walls defining the region of interest
# ============================================================

lower: LOWER_WALLS ARG=q AT=0.5 KAPPA=3000.0 EXP=2
upper: UPPER_WALLS ARG=q AT=1.02 KAPPA=3000.0 EXP=2


# ============================================================
# 3. Well-tempered metadynamics
# ============================================================

MOLINFO STRUCTURE=md_relax_310K_310K_30ns_r0_pbc_center_compact_dump29999_Protein.pdb

meta: METAD ...
    ARG=q
    SIGMA=0.02
    HEIGHT=0.0
    PACE=99999999
    TEMP=310.0
    BIASFACTOR=10.0
    GRID_MIN=-0.02
    GRID_MAX=1.05
    GRID_BIN=250
    FILE=HILLS
... meta:


# Remove all biases
weights: REWEIGHT_BIAS ...
    ARG=meta.bias,lower.bias,upper.bias
    TEMP=310
... weights:

# Construct the unbiased q distribution
histo: HISTOGRAM ...
    ARG=q
    GRID_MIN=-0.02
    GRID_MAX=1.05
    GRID_BIN=100
    BANDWIDTH=0.02
    LOGWEIGHTS=weights
... histo:

# Convert probability into free energy
fes: CONVERT_TO_FES ...
    GRID=histo
    TEMP=310
... fes:

DUMPGRID GRID=histo FILE=histo_q.dat STRIDE=0
DUMPGRID GRID=fes FILE=fes_q.dat STRIDE=0

PRINT ARG=q,meta.bias,lower.bias,upper.bias,weights       FILE=COLVAR_REWEIGHT STRIDE=500
    