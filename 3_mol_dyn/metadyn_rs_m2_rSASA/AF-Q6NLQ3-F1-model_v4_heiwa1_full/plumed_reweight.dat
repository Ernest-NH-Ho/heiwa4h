  ATOMS1092=3622,3715 SWITCH1092={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.37075} WEIGHT1092=0.0009090909091
  ATOMS1093=3625,3707 SWITCH1093={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.37214} WEIGHT1093=0.0009090909091
  ATOMS1094=3625,3710 SWITCH1094={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.37138} WEIGHT1094=0.0009090909091
  ATOMS1095=3627,3707 SWITCH1095={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.39583} WEIGHT1095=0.0009090909091
  ATOMS1096=3645,3715 SWITCH1096={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.35064} WEIGHT1096=0.0009090909091
  ATOMS1097=3646,3708 SWITCH1097={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.31481} WEIGHT1097=0.0009090909091
  ATOMS1098=3646,3710 SWITCH1098={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.39123} WEIGHT1098=0.0009090909091
  ATOMS1099=3646,3712 SWITCH1099={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.36359} WEIGHT1099=0.0009090909091
  ATOMS1100=3646,3715 SWITCH1100={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.26577} WEIGHT1100=0.0009090909091
  SUM
... q:


# ============================================================
# 2. Optional walls defining the region of interest
# ============================================================

lower: LOWER_WALLS ARG=q AT=0.5 KAPPA=3000.0 EXP=2
upper: UPPER_WALLS ARG=q AT=1.02 KAPPA=3000.0 EXP=2


# ============================================================
# 3. Well-tempered metadynamics
# ============================================================

MOLINFO STRUCTURE=md_relax_310K_310K_30ns_r0_pbc_center_compact_dump29999_Protein.pdb

meta: METAD ...
    ARG=q
    SIGMA=0.02
    HEIGHT=0.0
    PACE=99999999
    TEMP=310.0
    BIASFACTOR=10.0
    GRID_MIN=-0.02
    GRID_MAX=1.05
    GRID_BIN=250
    FILE=HILLS
... meta:


# Remove all biases
weights: REWEIGHT_BIAS ...
    ARG=meta.bias,lower.bias,upper.bias
    TEMP=310
... weights:

# Construct the unbiased q distribution
histo: HISTOGRAM ...
    ARG=q
    GRID_MIN=-0.02
    GRID_MAX=1.05
    GRID_BIN=100
    BANDWIDTH=0.02
    LOGWEIGHTS=weights
... histo:

# Convert probability into free energy
fes: CONVERT_TO_FES ...
    GRID=histo
    TEMP=310
... fes:

DUMPGRID GRID=histo FILE=histo_q.dat STRIDE=0
DUMPGRID GRID=fes FILE=fes_q.dat STRIDE=0

PRINT ARG=q,meta.bias,lower.bias,upper.bias,weights       FILE=COLVAR_REWEIGHT STRIDE=500
    